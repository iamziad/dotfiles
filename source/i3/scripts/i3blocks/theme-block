#!/bin/bash

TOGGLE_SCRIPT="${TOGGLE_SCRIPT:-$HOME/scripts/toggle-darkmode.sh}"
ICON_DARK="GTK ${ICON_DARK:-}"
ICON_LIGHT="GTK ${ICON_LIGHT:-} "

STATE_FILE="${XDG_RUNTIME_DIR:-$HOME/.cache}/gtk-theme-state"
GTK3_SETTINGS="$HOME/.config/gtk-3.0/settings.ini"

if [ "${BLOCK_BUTTON}" = "1" ]; then
    bash "$TOGGLE_SCRIPT" > /dev/null 2>&1
fi

if [ -f "$STATE_FILE" ]; then
    CURRENT=$(cat "$STATE_FILE")
else
    CURRENT=$(grep "gtk-theme-name" "$GTK3_SETTINGS" 2>/dev/null \
              | cut -d'=' -f2 | tr -d ' \r')
fi

if [[ "$CURRENT" == *"dark"* ]]; then
    echo "$ICON_DARK"
    echo "$ICON_DARK"
    echo "#fabd2f"
else
    echo "$ICON_LIGHT"
    echo "$ICON_LIGHT"
    echo "#d79921"
fi
