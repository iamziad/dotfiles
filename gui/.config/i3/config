# ============================================================
#  i3 Window Manager Configuration
# ============================================================

# Modifier key
set $mod Mod4

# X11 Keyboard
exec_always --no-startup-id setxkbmap -layout us,ara -variant ,digits -option grp:win_space_toggle -option ctrl:nocaps
exec_always --no-startup-id xset r rate 230 35 &

# Xresources
exec_always --no-startup-id xrdb -merge "$XDG_CONFIG_HOME/x11/Xresources"

# exec_always --no-startup-id ~/.local/bin/scripts/screenlayout.sh

# Paths
set $SCRIPTS_GLOBAL  /home/ziad/.local/bin/scripts
set $TERM            /usr/bin/alacritty
set $LAUNCHER        i3-dmenu-desktop --dmenu="dmenu -i -fn JetBrainsMonoNerdFont:size=11"

# Monitors
set $pri HDMI-A-0
set $sec DisplayPort-0

# Workspaces
set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

# ============================================================
#  Appearance
# ============================================================

font pango:JetBrainsMono Nerd Font 10
hide_edge_borders both

set $GAPS_OUTER 0px
set $GAPS_INNER 0px

gaps outer $GAPS_OUTER
gaps inner $GAPS_INNER
smart_gaps on

# ============================================================
#  Bar
# ============================================================

bar {
status_command i3blocks -c ~/.config/i3/i3blocks.conf
# status_command i3status -c ~/.config/i3/i3status.conf
font pango:JetBrainsMono Nerd Font 9

position     bottom
tray_output  $pri

   colors {
    # urgent_workspace #4c7899 #282828 #FFFFFF
    urgent_workspace #ff0000 #282828 #FFFFFF
    background #1d1d1d
   }
}


# ============================================================
#  Workspace Settings
# ============================================================

workspace_layout                tabbed
# workspace_auto_back_and_forth   yes
focus_follows_mouse             yes
popup_during_fullscreen         leave_fullscreen
focus_on_window_activation      focus
show_marks                      yes

# Monitor assignments
workspace $ws1  output $pri
workspace $ws2  output $pri
workspace $ws3  output $pri
workspace $ws4  output $pri
workspace $ws5  output $pri

workspace $ws6  output $sec
workspace $ws7  output $sec
workspace $ws8  output $sec
workspace $ws9  output $sec
workspace $ws10 output $sec

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ============================================================
#  Startup
# ============================================================

exec_always --no-startup-id i3-msg 'workspace $ws6; workspace $ws1'
#exec        --no-startup-id runsvdir ~/.config/service
exec        --no-startup-id xss-lock -l --transfer-sleep-lock -- $SCRIPTS_GLOBAL/i3/i3lock.sh

exec        --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec        --no-startup-id xsettingsd
exec        --no-startup-id picom --config ~/.config/picom/.picom.conf -b
exec        --no-startup-id redshift-gtk
exec        --no-startup-id gromit-mpx
exec        --no-startup-id emacs --daemon

exec_always --no-startup-id $SCRIPTS_GLOBAL/feh.sh

# ============================================================
#  Window Rules
# ============================================================

set $FLOAT   floating enable
set $CENTER  move position center
set $SIZE_LG resize set 1200 800
set $SIZE_MD resize set 1000 800
set $SIZE_SM resize set 800 600
set $SIZE_XS resize set 800 370

# App assignments
assign [class="Anki"]    $ws2
assign [class="Spotify"] $ws4
assign [class="obs"]     $ws5

# Floating rules
for_window [class="Thunar"]                             $FLOAT, $SIZE_LG, $CENTER
for_window [class="Pcmanfm"]                            $FLOAT, $SIZE_MD, $CENTER
for_window [class="imv"]                                $FLOAT, $SIZE_LG, $CENTER
for_window [class="Vimiv"]                              $FLOAT, $SIZE_MD, $CENTER
for_window [class="Anki"]                               $FLOAT, $SIZE_LG, $CENTER
for_window [class="Lxappearance"]                       $FLOAT, $SIZE_LG, $CENTER
for_window [class="vlc"]                                $FLOAT, $SIZE_MD, $CENTER
for_window [class="mpv"]                                $FLOAT, $SIZE_MD, $CENTER
for_window [class="Gnome-disks"]                        $FLOAT, $SIZE_LG, $CENTER
for_window [class="pavucontrol"]                        $FLOAT, $SIZE_SM, $CENTER
for_window [class="Blueman-manager"]                    $FLOAT, $SIZE_SM, $CENTER
for_window [class="Qalculate"]                          $FLOAT, $CENTER
for_window [class="Brave-browser" window_role="pop-up"] $FLOAT, $SIZE_SM, $CENTER
for_window [instance="Devtools"]                        $FLOAT, $SIZE_LG, $CENTER
for_window [instance="nitrogen"]                        $FLOAT, $SIZE_LG, $CENTER
for_window [instance="virt-manager"]                    $FLOAT, $SIZE_LG, $CENTER
for_window [window_role="alert"]                        $FLOAT
for_window [window_role="pop-up"]                       $FLOAT, $SIZE_SM, $CENTER
for_window [window_role="dialog"]                       $FLOAT
for_window [window_role="task_dialog"]                  $FLOAT
for_window [window_type="dialog"]                       $FLOAT

# Scratchpads
for_window [instance="spterm"] $FLOAT, move scratchpad, border pixel 3

# ============================================================
#  Focus
# ============================================================

bindsym Control+Mod1+h     focus left
bindsym Control+Mod1+j     focus down
bindsym Control+Mod1+k     focus up
bindsym Control+Mod1+l     focus right

bindsym Control+Mod1+Left  focus left
bindsym Control+Mod1+Down  focus down
bindsym Control+Mod1+Up    focus up
bindsym Control+Mod1+Right focus right

bindsym $mod+o focus mode_toggle

# ============================================================
#  Window Movement & Layout
# ============================================================

# Move focused window
bindsym $mod+Shift+h     move left
bindsym $mod+Shift+j     move down
bindsym $mod+Shift+k     move up
bindsym $mod+Shift+l     move right

bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# Mouse behavior
floating_modifier $mod
tiling_drag modifier titlebar

# Layout controls
bindsym $mod+h       split h
bindsym $mod+v       split v
bindsym $mod+f       fullscreen toggle
bindsym $mod+s       layout stacking
bindsym $mod+w       layout tabbed
bindsym $mod+e       layout toggle split
bindsym $mod+Shift+f floating toggle
bindsym $mod+Shift+p focus parent
bindsym $mod+Shift+x focus child

# ============================================================
#  Modes
# ============================================================

# Power mode
set $mode_system Power Options: Lock(l) - Exit(e) - Suspend(s) - Reboot(r) - Poweroff(o) - Cancel(Esc)
mode "$mode_system" {
bindsym l      exec --no-startup-id $SCRIPTS_GLOBAL/i3/i3lock.sh, mode "default"
bindsym e      exec --no-startup-id i3-msg exit,        mode "default"
bindsym s      exec --no-startup-id systemctl suspend,   mode "default"
bindsym r      exec --no-startup-id systemctl reboot,    mode "default"
bindsym o      exec --no-startup-id systemctl poweroff,  mode "default"
bindsym Escape mode "default"
}
bindsym $mod+Shift+q mode "$mode_system"

# Resize mode
mode "resize" {
bindsym h      resize shrink width  5 px or 5 ppt
bindsym j      resize grow   height 5 px or 5 ppt
bindsym k      resize shrink height 5 px or 5 ppt
bindsym l      resize grow   width  5 px or 5 ppt

bindsym Left   resize shrink width  5 px or 5 ppt
bindsym Down   resize grow   height 5 px or 5 ppt
bindsym Up     resize shrink height 5 px or 5 ppt
bindsym Right  resize grow   width  5 px or 5 ppt

bindsym Return mode "default"
bindsym Escape mode "default"
bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# Gaps mode
set $mode_gaps Gaps: Inner(+/-) - Outer(shift +/-) - No gaps(0) - Resotre(r) - Cancel(Esc)
mode "$mode_gaps" {
bindsym plus gaps inner current plus 5
bindsym minus gaps inner current minus 5

bindsym shift+plus gaps outer current plus 5
bindsym shift+minus gaps outer current minus 5

bindsym r gaps inner current set $GAPS_INNER
bindsym r gaps outer current set $GAPS_OUTER

bindsym 0 gaps inner current set 0
bindsym 0 gaps outer current set 0

bindsym Escape mode "default"
bindsym Return mode "default"
}
bindsym $mod+g mode "$mode_gaps"

# ============================================================
#  Media Controls
# ============================================================

# Volume
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume --limit 1.5 @DEFAULT_AUDIO_SINK@ 5%+ && pkill -RTMIN+10 i3blocks
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-            && pkill -RTMIN+10 i3blocks
bindsym XF86AudioMute        exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle           && pkill -RTMIN+10 i3blocks

# Mic
bindsym $mod+m exec --no-startup-id sh -c 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && pkill -RTMIN+10 i3blocks'

# Brightness
bindsym $mod+F5 exec --no-startup-id $SCRIPTS_GLOBAL/brightness.sh Samsung -
bindsym $mod+F6 exec --no-startup-id $SCRIPTS_GLOBAL/brightness.sh Samsung +
bindsym $mod+F7 exec --no-startup-id $SCRIPTS_GLOBAL/brightness.sh Dell -
bindsym $mod+F8 exec --no-startup-id $SCRIPTS_GLOBAL/brightness.sh Dell +

# ============================================================
#  Keybindings
# ============================================================

# Core
bindsym $mod+Return exec $TERM || /usr/bin/i3-sensible-terminal
bindsym $mod+d      exec --no-startup-id $LAUNCHER
bindsym $mod+q      kill

# i3 control
bindsym $mod+Shift+c exec i3-msg reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Logout Session?' -B 'Yes, exit i3' 'i3-msg exit'"

# Dmenu

# Applications
bindsym F1           exec pcmanfm
bindsym F2           exec qalculate-gtk
bindsym F4           exec spotify
bindsym F5           exec --no-startup-id xcolor -s clipboard
bindsym $mod+z       exec emacsclient -c
bindsym $mod+l       exec $SCRIPTS_GLOBAL/open-dired-home.sh
bindsym $mod+Shift+g exec --no-startup-id $SCRIPTS_GLOBAL/toggle-darkmode.sh

# Screenshots
bindsym Print            exec --no-startup-id $SCRIPTS_GLOBAL/screenshot.sh full   clip
bindsym $mod+Print       exec --no-startup-id $SCRIPTS_GLOBAL/screenshot.sh full   save
bindsym $mod+Shift+Print exec --no-startup-id $SCRIPTS_GLOBAL/screenshot.sh select clip
bindsym $mod+ctrl+Print  exec --no-startup-id $SCRIPTS_GLOBAL/screenshot.sh select save

# ============================================================
#  Scratchpads
# ============================================================

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus [class="^(?!spterm$).*"] scratchpad show

bindsym $mod+k exec i3-msg '[class="spterm"] scratchpad show' || exec $TERM -o "window.opacity=0.90" --class spterm
for_window [class="spterm"] floating enable, move scratchpad
