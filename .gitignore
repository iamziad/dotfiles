# Emacs
*~
\#*\#
*.elc
# editors/.config/emacs/etc/
# editors/.config/emacs/var/
# editors/.config/emacs/cache/
# editors/.config/emacs/straight/
# editors/.config/emacs/elpa/
# editors/.config/emacs/eln-cache/
# editors/.config/emacs/recentf
# editors/.config/emacs/transient/
# editors/.config/emacs/tree-sitter/
# editors/.config/emacs/custom.el

editors/.config/emacs/*
editors/.config/emacs-old/*

!editors/.config/emacs/modules/
!editors/.config/emacs/snippets/
!editors/.config/emacs/themes/
!editors/.config/emacs/init.el
!editors/.config/emacs/early-init.el

!editors/.config/emacs-old/init.el
!editors/.config/emacs-old/early-init.el
!editors/.config/emacs-old/init.org
!editors/.config/emacs-old/README.org
!editors/.config/emacs-old/lisp/

# Vim
editors/.config/vim/plugged/
editors/.config/vim/autoload/

# Folder-specific ignore
.DS_Store

# Tmux plugins
tmux/.tmux/plugins/
