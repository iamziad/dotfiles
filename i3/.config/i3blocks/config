separator_block_width=15
markup=none
color=#f5f5f5

[void_update]
markup=pango
interval=43200

[mediaplayer]
command=$SCRIPT_DIR/mediaplayer/mediaplayer
# label=󰝚
color=#c0c0c0
instance=spotify
interval=5
signal=10

[org-timer]
interval=1
color=#d8a657

