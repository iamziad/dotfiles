# Modifier key
set $mod Mod4

# Xresources
exec --no-startup-id xrdb -merge "$HOME/.Xresources"

set $TERM alacritty
set $LAUNCHER i3-dmenu-desktop --dmenu="dmenu -i -fn monospace:size=11"
set $BAR i3blocks

# Monitors
set $pri HDMI-A-0
set $sec DisplayPort-0

# Appearance
font pango:JetBrainsMono Nerd Font 9
hide_edge_borders smart

gaps outer 0
gaps inner 0
smart_gaps on

for_window [class="^.*"] border pixel 3

# Bar
bar {
    status_command $BAR -c ~/.config/i3/$BAR.conf
    tray_output $pri

    colors {
        urgent_workspace #ff0000 #282828 #FFFFFF
    }
}

# Workspace settings
workspace_layout tabbed
focus_follows_mouse yes
popup_during_fullscreen leave_fullscreen
focus_on_window_activation focus
show_marks yes

# Monitor assignments
workspace 1 output $pri
workspace 2 output $pri
workspace 3 output $pri
workspace 4 output $pri
workspace 5 output $pri

workspace 6 output $sec
workspace 7 output $sec
workspace 8 output $sec
workspace 9 output $sec
workspace 10 output $sec

# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Window rules
for_window [class="mpv"] floating enable, resize set 1000 800, move position center
for_window [class="pavucontrol"] floating enable, resize set 800 600, move position center
for_window [class="Qalculate"] floating enable, move position center
for_window [class="Brave-browser" window_role="pop-up"] floating enable, resize set 800 600, move position center
for_window [instance="Devtools"] floating enable, resize set 800 600, move position center
for_window [window_role="alert"] floating enable
for_window [window_role="pop-up"] floating enable, resize set 800 600, move position center
for_window [window_role="dialog"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_type="dialog"] floating enable

# Scratchpads
for_window [instance="spterm"] floating enable, move scratchpad, border pixel 3

# Focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+o focus mode_toggle

# Move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Mouse behavior
floating_modifier $mod
tiling_drag modifier titlebar

# Layout controls
bindsym $mod+Control+h split h
bindsym $mod+Control+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+f floating toggle
bindsym $mod+Shift+p focus parent
bindsym $mod+Shift+x focus child

# Power mode
mode "Power Options: Lock(l) - Exit(e) - Suspend(s) - Reboot(r) - Poweroff(o) - Cancel(Esc)" {
    bindsym l exec --no-startup-id xfce4-screensaver-command -l, mode "default"
    bindsym e exec --no-startup-id i3-msg exit, mode "default"
    bindsym s exec --no-startup-id systemctl suspend, mode "default"
    bindsym r exec --no-startup-id systemctl reboot, mode "default"
    bindsym o exec --no-startup-id systemctl poweroff, mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Shift+e mode "Power Options: Lock(l) - Exit(e) - Suspend(s) - Reboot(r) - Poweroff(o) - Cancel(Esc)"

# Resize mode
mode "resize" {
    bindsym h resize shrink width 5 px or 5 ppt
    bindsym j resize grow height 5 px or 5 ppt
    bindsym k resize shrink height 5 px or 5 ppt
    bindsym l resize grow width 5 px or 5 ppt

    bindsym Left resize shrink width 5 px or 5 ppt
    bindsym Down resize grow height 5 px or 5 ppt
    bindsym Up resize shrink height 5 px or 5 ppt
    bindsym Right resize grow width 5 px or 5 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# Gaps mode
mode "Gaps: Inner(+/-) - Outer(shift +/-) - No gaps(0) - Restore(r) - Cancel(Esc)" {
    bindsym plus gaps inner current plus 5
    bindsym minus gaps inner current minus 5
    bindsym shift+plus gaps outer current plus 5
    bindsym shift+minus gaps outer current minus 5
    bindsym r gaps inner current set 0
    bindsym r gaps outer current set 0
    bindsym 0 gaps inner current set 0
    bindsym 0 gaps outer current set 0
    bindsym Escape mode "default"
    bindsym Return mode "default"
}
bindsym $mod+g mode "Gaps: Inner(+/-) - Outer(shift +/-) - No gaps(0) - Restore(r) - Cancel(Esc)"

# Startup
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec_always --no-startup-id setxkbmap -layout us,ara -option grp:win_space_toggle,ctrl:nocaps
exec_always --no-startup-id xset r rate 230 35
exec_always --no-startup-id my-random-wallpaper
exec --no-startup-id xss-lock -- xfce4-screensaver-command --lock
exec --no-startup-id THRESHOLD=300 DIM_LEVEL=0 POLL_INTERVAL=1 my-dim-inactive DisplayPort-0:2
exec --no-startup-id xfce4-screensaver
exec --no-startup-id ~/.screenlayout/dual.sh
exec --no-startup-id redshift-gtk
exec --no-startup-id xsettingsd
exec --no-startup-id emacs --daemon
exec --no-startup-id dunst
exec --no-startup-id picom --config ~/.config/picom/picom.conf

# Media controls
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume --limit 1.5 @DEFAULT_AUDIO_SINK@ 5%+ && pkill -RTMIN+10 i3blocks
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && pkill -RTMIN+10 i3blocks
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && pkill -RTMIN+10 i3blocks
bindsym $mod+Control+m exec --no-startup-id sh -c 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && pkill -RTMIN+10 i3blocks'

# Brightness
bindsym $mod+F5 exec --no-startup-id my-brightness Samsung -
bindsym $mod+F6 exec --no-startup-id my-brightness Samsung +
bindsym $mod+F7 exec --no-startup-id my-brightness Dell -
bindsym $mod+F8 exec --no-startup-id my-brightness Dell +

# Keybindings
bindsym $mod+Return exec $TERM
bindsym $mod+d exec --no-startup-id $LAUNCHER
bindsym $mod+q kill

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

bindsym F4 exec --no-startup-id xcolor -s clipboard
bindsym $mod+z exec emacsclient -c
bindsym $mod+Shift+g exec --no-startup-id my-toggle-darkmode

bindsym Print exec --no-startup-id my-screenshot full clip
bindsym $mod+Print exec --no-startup-id my-screenshot full save
bindsym $mod+Shift+Print exec --no-startup-id my-screenshot select clip
bindsym $mod+Control+Print exec --no-startup-id my-screenshot select save

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus [class="^(?!spterm$).*"] scratchpad show
bindsym $mod+m exec i3-msg '[class="spterm"] scratchpad show' || exec alacritty -o "window.opacity=0.95" --class spterm -e tmux new-session -A -s scratch
for_window [class="spterm"] floating enable, move scratchpad
