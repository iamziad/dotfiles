       ;; Backgrounds
       (bg0 "#181616")
       (bg0-soft "#222020")
       (bg1 "#2a2828")
       (bg2 "#343232")
       (bg3 "#3e3c3c")
       (bg4 "#4e4c4c")
       ;; Foregrounds
       (fg-1 "#ffffff")
       (fg0 "#e9e9e9")
       (fg1 "#d2d2d2")
       (fg2 "#bbbbbb")
       (fg3 "#a4a4a4")
       (fg4 "#8d8d8d")
       (gray "#707070")
       ;; Signature accents -- these three hues ARE the theme
       (green "#a7b26c")
       (green-bright "#c0cb80")
       (green-dim "#858e5c")
       (teal "#659f94")
       (teal-bright "#81b8ad")
       (teal-dim "#537d76")
       ;; Minimal alert -- reserved for genuine error/danger/destructive states only
