;;; verdigris-theme.el --- Minimal dark theme (black bg, green + teal accents) -*- lexical-binding: t -*-

;; Author: Ziad
;; A minimal dark theme built on the same structure as gruvbox-theme.el.
;; Palette: true-black background, off-white foreground, with green and teal
;; as the two signature accent hues (each with a bright/dim variant).
;; One muted red is kept, reserved only for genuine error/danger/destructive
;; states (compile errors, failed searches, deleted diff lines, "rm -rf"-tier
;; git actions, sudo). Everything else in the theme is grayscale + green/teal.
;; No palette switching, no gm/config menu, no light variant.

;;;###autoload
(deftheme verdigris
  "Verdigris: a black-background theme with green and teal as its signature accents.")

